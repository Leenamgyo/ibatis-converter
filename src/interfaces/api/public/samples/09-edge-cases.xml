<?xml version="1.0" encoding="UTF-8"?>
<sqlMap namespace="edge">

  <!-- Scenario 9 — the cases that are supposed to degrade loudly rather
       than silently: `$...$` substitution, SQL the flattener can't
       resolve to one parseable statement, and Oracle-only syntax no
       available node-sql-parser dialect accepts. Each must still parse,
       resolve and convert; only table/column/join/lineage analysis is
       unavailable, with a SQL_PARSE_FAILED warning saying so. -->

  <select id="rawSubstitutionOrderBy" parameterClass="map" resultClass="map">
    SELECT C.CUSTOMER_ID, C.CUSTOMER_NAME
    FROM CUSTOMER C
    WHERE C.STATUS = #status#
    ORDER BY $orderByColumn$ $orderDirection$
  </select>

  <select id="dynamicTableName" parameterClass="map" resultClass="map">
    SELECT COUNT(*) AS TOTAL
    FROM $tableName$
    WHERE STATUS = #status#
  </select>

  <!-- The month table: a fixed prefix with a variable glued to it. The
       변환 view lists it as written, ORDERS_$yyyymm$, and renames nothing. -->
  <select id="monthlyTableName" parameterClass="map" resultClass="map">
    SELECT M.ORDER_ID, M.TOTAL_AMOUNT
    FROM ORDERS_$yyyymm$ M
    WHERE M.CUSTOMER_ID = #customerId#
  </select>

  <!-- The rollback table: a condition glues _RBK onto the name. Both
       ORDERS and ORDERS_RBK are tables this statement uses, and renaming
       ORDERS also renames the rollback table at runtime (SALES_ORDER_RBK):
       the 변환 view checks that against the mapping. -->
  <select id="rollbackTableSuffix" parameterClass="map" resultClass="map">
    SELECT O.ORDER_ID, O.STATUS
    FROM ORDERS<isEqual property="rbkYn" compareValue="Y">_RBK</isEqual> O
    WHERE O.CUSTOMER_ID = #customerId#
  </select>

  <!-- Two mutually exclusive branches both supplying the FROM table: a
       dynamic table name. Keeping both would give the unparseable
       "FROM ARCHIVED_ORDER O ORDERS O", so each branch is analyzed on its
       own and both tables are reported (and drawn as one dynamic table). -->
  <select id="mutuallyExclusiveFromBranches" parameterClass="map" resultClass="map">
    SELECT O.ORDER_ID
    FROM
    <isEqual property="scope" compareValue="ARCHIVE">
      ARCHIVED_ORDER O
    </isEqual>
    <isNotEqual property="scope" compareValue="ARCHIVE">
      ORDERS O
    </isNotEqual>
    WHERE O.STATUS = #status#
  </select>

  <!-- Oracle's (+) outer join operator: no SQL parser dialect accepts it, so the
       analyzer takes it out before parsing and reports the join as a LEFT JOIN
       (C kept, O optional). See SqlAnalyzer#stripOracleOuterJoins. -->
  <select id="oracleOuterJoinOperator" parameterClass="map" resultClass="map">
    SELECT O.ORDER_ID, C.CUSTOMER_NAME
    FROM ORDERS O, CUSTOMER C
    WHERE C.CUSTOMER_ID = O.CUSTOMER_ID(+)
      AND O.STATUS = #status#
  </select>

  <select id="veryLongInListViaIterate" parameterClass="map" resultClass="map">
    SELECT P.PRODUCT_ID, P.PRODUCT_NAME
    FROM PRODUCT P
    WHERE P.PRODUCT_ID IN
    <iterate property="productIds" open="(" close=")" conjunction=",">
      #productIds[]#
    </iterate>
    AND P.STATUS = #status#
  </select>

  <select id="selectWithNullValueColumn" parameterClass="map" resultClass="map">
    SELECT C.CUSTOMER_ID, C.PHONE
    FROM CUSTOMER C
    WHERE C.CUSTOMER_ID = #customerId#
  </select>

</sqlMap>
