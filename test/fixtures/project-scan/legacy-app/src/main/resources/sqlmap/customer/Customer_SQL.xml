<?xml version="1.0" encoding="EUC-KR"?>
<!DOCTYPE sqlMap PUBLIC "-//ibatis.apache.org//DTD SQL Map 2.0//EN" "http://ibatis.apache.org/dtd/sql-map-2.dtd">
<sqlMap namespace="customer">
  <!-- 고객 조회 (레거시, EUC-KR 인코딩) -->
  <select id="findCustomer" parameterClass="string" resultClass="java.util.HashMap">
    SELECT C.CUST_NO, C.CUST_NM /* 고객명 */
      FROM TB_CUST_M C
     WHERE C.CUST_NO = #value#
       AND C.USE_YN = '사용'
  </select>
</sqlMap>
