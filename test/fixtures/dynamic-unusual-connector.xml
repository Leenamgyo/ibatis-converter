<?xml version="1.0" encoding="UTF-8"?>
<sqlMap namespace="misc">

  <select id="weirdWhere" parameterClass="map" resultClass="Row">
    SELECT * FROM T
    <dynamic prepend="WHERE">
      <isNotNull property="a" prepend="AND">A = #a#</isNotNull>
      <isNotNull property="b" prepend="XOR">B = #b#</isNotNull>
    </dynamic>
  </select>

</sqlMap>
