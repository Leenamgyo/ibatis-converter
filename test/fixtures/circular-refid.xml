<?xml version="1.0" encoding="UTF-8"?>
<sqlMap namespace="circular">

  <sql id="a">
    A_COL = 1 AND
    <include refid="b"/>
  </sql>

  <sql id="b">
    B_COL = 2 AND
    <include refid="c"/>
  </sql>

  <sql id="c">
    C_COL = 3 AND
    <include refid="a"/>
  </sql>

  <select id="getRow" parameterClass="map" resultClass="Row">
    SELECT *
    FROM T
    WHERE
    <include refid="a"/>
  </select>

</sqlMap>
